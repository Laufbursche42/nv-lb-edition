<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Covers getExternalFilesDir("logs")/navee-debug.log for the FileProvider share. -->
    <external-files-path name="logs" path="logs/"/>
    <!-- Covers getCacheDir()/exports/ride-*.csv|json for the ride-log FileProvider share. -->
    <cache-path name="exports" path="exports/"/>
    <!-- Public Downloads root: the app-update installer builds a FileProvider URI here as a fallback
         when DownloadManager does not return a content URI (installDownloadedApk). -->
    <external-path name="downloads" path="Download/"/>
</paths>
